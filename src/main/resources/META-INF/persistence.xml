<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
             https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="gestion-stock-pu"
                      transaction-type="RESOURCE_LOCAL">

        <!-- Proveedor Hibernate -->
        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <!-- Entidades del sistema -->
        <class>model.Rubro</class>
        <class>model.Proveedor</class>
        <class>model.Cliente</class>
        <class>model.Articulo</class>
        <class>model.Compra</class>
        <class>model.DetalleCompra</class>
        <class>model.Factura</class>
        <class>model.DetalleFactura</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <!-- Configuración de conexión MySQL -->
        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/gestion_stock"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>
            
            <property name="jakarta.persistence.jdbc.password"
                      value="patan0843"/>

            <!-- Hibernate valida la estructura de la base de datos -->
            <property name="hibernate.hbm2ddl.auto"
                      value="validate"/>

            <!-- Visualización de consultas SQL -->
            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>